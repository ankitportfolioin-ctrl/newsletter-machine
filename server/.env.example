# Database
DATABASE_URL=postgresql://user:password@localhost:5432/newsletter_machine

# JWT Secret (generate a strong random string)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Server
PORT=3001
NODE_ENV=development

# Reddit API (create app at https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REDIRECT_URI=http://localhost:3001/api/auth/reddit/callback

# YouTube Data API (get from https://console.cloud.google.com/)
YOUTUBE_API_KEY=

# OpenAI API (get from https://platform.openai.com/)
OPENAI_API_KEY=

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Email (optional, for newsletter delivery)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@yourdomain.com
