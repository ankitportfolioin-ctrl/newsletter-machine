{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "playwright": {
        "command": "npx",
        "args": ["@playwright/mcp@latest"],
        "env": {
          "PLAYWRIGHT_BASE_URL": "http://localhost:8000",
          "PLAYWRIGHT_API_URL": "http://localhost:8000"
        }
      }
    }
  },
  "commands": {
    "test:e2e": "uv run pytest tests/e2e -v --tb=short -m e2e",
    "test:e2e:headed": "uv run pytest tests/e2e -v --tb=short -m e2e --headed",
    "test:e2e:ui": "uv run pytest tests/e2e -v --tb=short -m e2e --ui",
    "test:all": "uv run pytest -v --tb=short"
  }
}