<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="color-scheme" content="light dark">
<meta name="supported-color-schemes" content="light dark">
<title>{{ n.subject }}</title>
<style>
:root {
  --bg: #fafafa;
  --bg-elevated: #ffffff;
  --fg: #18181b;
  --fg-muted: #71717a;
  --border: #e4e4e7;
  --border-strong: #d4d4d8;
  --accent: #2563eb;
  --accent-hover: #1d4ed8;
  --accent-soft: #eff6ff;
  --danger: #dc2626;
  --danger-hover: #b91c1c;
  --danger-soft: #fef2f2;
  --success: #16a34a;
  --success-soft: #f0fdf4;
  --warning: #ea580c;
  --warning-soft: #fff7ed;
  --shadow-sm: 0 1px 2px rgba(0,0,0,0.04);
  --shadow: 0 1px 3px rgba(0,0,0,0.06), 0 1px 2px rgba(0,0,0,0.04);
  --shadow-lg: 0 4px 6px -1px rgba(0,0,0,0.06), 0 2px 4px -2px rgba(0,0,0,0.04);
  --radius: 8px;
  --radius-lg: 12px;
  --font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  --font-mono: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
  --space-1: 4px;
  --space-2: 8px;
  --space-3: 12px;
  --space-4: 16px;
  --space-5: 24px;
  --space-6: 32px;
}

@media (prefers-color-scheme: dark) {
  :root {
    --bg: #09090b;
    --bg-elevated: #18181b;
    --fg: #fafafa;
    --fg-muted: #a1a1aa;
    --border: #27272a;
    --border-strong: #3f3f46;
    --accent: #3b82f6;
    --accent-hover: #2563eb;
    --accent-soft: #1e3a5f;
    --danger: #ef4444;
    --danger-hover: #dc2626;
    --danger-soft: #450a0a;
    --success: #22c55e;
    --success-soft: #052e16;
    --warning: #f97316;
    --warning-soft: #fff7ed;
    --shadow-sm: 0 1px 2px rgba(0,0,0,0.2);
    --shadow: 0 1px 3px rgba(0,0,0,0.3), 0 1px 2px rgba(0,0,0,0.2);
    --shadow-lg: 0 4px 6px -1px rgba(0,0,0,0.3), 0 2px 4px -2px rgba(0,0,0,0.2);
  }
}

* {
  box-sizing: border-box;
}

html {
  font-size: 14px;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

body {
  font-family: var(--font-sans);
  background: var(--bg);
  color: var(--fg);
  line-height: 1.6;
  margin: 0;
  padding: 0;
}

.wrap {
  width: 100%;
  background: var(--bg);
  padding: 32px 0;
}

.card {
  max-width: 640px;
  margin: 0 auto;
  background: var(--bg-elevated);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow);
}

.header {
  background: var(--fg);
  color: var(--bg-elevated);
  padding: var(--space-5);
}

.header h1 {
  margin: 0 0 var(--space-1);
  font-size: 1.5rem;
  font-weight: 600;
}

.header p {
  margin: 0;
  font-size: 0.875rem;
  opacity: 0.8;
}

.preheader {
  display: none;
  max-height: 0;
  overflow: hidden;
  opacity: 0;
}

.section {
  padding: var(--space-4) var(--space-5);
  border-top: 1px solid var(--border);
}

.section h2 {
  margin: 0 0 var(--space-3);
  font-size: 1rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  color: var(--fg-muted);
}

.story {
  margin: 0 0 var(--space-4);
}

.story h3 {
  margin: 0 0 var(--space-2);
  font-size: 1.125rem;
  font-weight: 600;
}

.story p {
  margin: 0 0 var(--space-2);
  font-size: 0.875rem;
  line-height: 1.6;
}

.why {
  font-size: 0.8125rem;
  color: var(--fg-muted);
}

.badge {
  display: inline-block;
  font-size: 0.6875rem;
  font-weight: 600;
  padding: 0.125rem 0.5rem;
  border-radius: 9999px;
  background: var(--accent-soft);
  color: var(--accent);
  text-transform: uppercase;
  letter-spacing: 0.025em;
}

.badge--success { background: var(--success-soft); color: var(--success); }
.badge--warning { background: var(--warning-soft); color: var(--warning); }
.badge--danger { background: var(--danger-soft); color: var(--danger); }
.badge--neutral { background: var(--border); color: var(--fg-muted); }

.meta {
  font-size: 0.75rem;
  color: var(--fg-muted);
  line-height: 1.5;
}

a {
  color: var(--accent);
  text-decoration: none;
  transition: color 0.15s ease;
}

a:hover {
  color: var(--accent-hover);
}

ul.tight {
  margin: 0;
  padding-left: 1.25rem;
  font-size: 0.875rem;
  line-height: 1.7;
}

li {
  margin-bottom: var(--space-2);
}

.quote {
  border-left: 3px solid var(--accent);
  padding-left: var(--space-3);
  margin: 0 0 var(--space-3);
  font-size: 0.875rem;
  font-style: italic;
  color: var(--fg);
}

.footer {
  padding: var(--space-4) var(--space-5);
  font-size: 0.75rem;
  color: var(--fg-muted);
  border-top: 1px solid var(--border);
}

@media (prefers-color-scheme: dark) {
  .wrap { background: var(--bg) !important; color: var(--fg) !important; }
  .card { background: var(--bg-elevated) !important; }
  .section { border-color: var(--border) !important; }
  .badge { background: var(--accent-soft) !important; color: var(--accent) !important; }
  .why, .meta, .footer { color: var(--fg-muted) !important; }
  a { color: var(--accent) !important; }
}
</style>
</head>
<body>
<span class="preheader">{{ n.preheader }}</span>
<div class="wrap">
<div class="card">
<div class="header">
<h1>{{ n.name }} — {{ n.niche_name }}</h1>
<p>{{ n.tagline }} &middot; {{ n.date }}</p>
</div>

{% if 'tldr' in n.enabled_sections and n.tldr %}
<div class="section">
<h2>TL;DR</h2>
<ul class="tight">
{% for bullet in n.tldr %}<li>{{ bullet }}</li>
{% endfor %}</ul>
</div>
{% endif %}

{% if 'top_stories' in n.enabled_sections and n.top_stories %}
<div class="section">
<h2>Top Stories</h2>
{% for story in n.top_stories %}
<div class="story">
<h3>{{ story.title }}</h3>
<p>{{ story.summary }}</p>
{% if story.why_it_matters %}<p class="why"><strong>Why it matters:</strong> {{ story.why_it_matters }}</p>{% endif %}
<p class="meta">{% for src in story.sources %}<span class="badge">{{ src.platform or 'link' }}</span> <a href="{{ src.url }}">{{ src.url }}</a>{% if not loop.last %}<br>{% endif %}{% endfor %}</p>
{% if story.feedback_up %}<p class="meta"><a href="{{ story.feedback_up }}">👍 Useful</a> &middot; <a href="{{ story.feedback_down }}">👎 Not useful</a></p>{% endif %}
</div>
{% endfor %}
</div>
{% endif %}

{% if 'trend_radar' in n.enabled_sections and n.trends %}
<div class="section">
<h2>Trend Radar</h2>
<ul class="tight">
{% for trend in n.trends %}<li><strong>{{ trend.label }}</strong> ({{ trend.momentum }}) — {{ trend.note }}</li>
{% endfor %}</ul>
</div>
{% endif %}

{% if 'platform_highlights' in n.enabled_sections and n.platform_highlights %}
<div class="section">
<h2>Platform Highlights</h2>
<ul class="tight">
{% for hl in n.platform_highlights %}<li><strong>{{ hl.platform }}</strong> — {{ hl.note }}</li>
{% endfor %}</ul>
</div>
{% endif %}

{% if 'voices' in n.enabled_sections and n.quotes %}
<div class="section">
<h2>Voices & Hot Takes</h2>
{% for q in n.quotes %}
<p class="quote">“{{ q.text }}”<br><span class="meta">— {{ q.author or 'unknown' }}, <a href="{{ q.url }}">source</a></span></p>
{% endfor %}
</div>
{% endif %}

{% if 'questions' in n.enabled_sections and n.questions %}
<div class="section">
<h2>Questions of the Day</h2>
<ul class="tight">
{% for q in n.questions %}<li>{{ q.question }} <span class="badge">{{ q.platform or 'link' }}</span> <a href="{{ q.url }}">discuss</a></li>
{% endfor %}</ul>
</div>
{% endif %}

{% if 'opportunities' in n.enabled_sections and n.opportunities %}
<div class="section">
<h2>Content Opportunities</h2>
<ul class="tight">
{% for o in n.opportunities %}<li><strong>{{ o.title }}</strong><br><span class="meta">Angle: {{ o.angle }} Format: {{ o.format }} Hook: {{ o.hook }}</span></li>
{% endfor %}</ul>
</div>
{% endif %}

{% if 'action' in n.enabled_sections and n.action_today %}
<div class="section">
<h2>Action of the Day</h2>
<p>{{ n.action_today }}</p>
</div>
{% endif %}

{% if 'coverage' in n.enabled_sections %}
<div class="section">
<h2>Coverage & Diagnostics</h2>
<p class="meta">{{ n.confidence_note }}</p>
{% if n.coverage %}<p class="meta">Items analyzed — {% for platform, count in n.coverage.items() %}{{ platform }}: {{ count }}{% if not loop.last %}, {% endif %}{% endfor %}</p>{% endif %}
{% if n.diagnostics %}
<p class="meta">Collector tiers — {% for name, stats in (n.diagnostics.get('stats') or {}).items() %}{{ name }}: {{ stats.tier_used }} ({{ stats['items'] }} items){% if not loop.last %}; {% endif %}{% endfor %}</p>
{% set errs = n.diagnostics.get('errors') or [] %}
{% if errs %}<p class="meta">Source notes — {% for e in errs[:5] %}{{ e }}{% if not loop.last %}; {% endif %}{% endfor %}</p>{% endif %}
{% set dropped = n.diagnostics.get('dropped') or {} %}
{% set dropped_total = dropped.values() | sum %}
{% if dropped_total %}<p class="meta">Ungrounded claims dropped by validator: {{ dropped_total }}</p>{% endif %}
{% endif %}
</div>
{% endif %}

<div class="footer">
<p>{{ n.name }} &middot; {{ n.date }} &middot; built by Newsletter Machine. Reply with feedback any time.</p>
</div>

</div>
</div>
</body>
</html>