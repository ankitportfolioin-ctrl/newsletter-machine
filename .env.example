# --- Core ---
# Local default (SQLite file). For Supabase/Postgres use ONE of:
#   Pooler (recommended for serverless/Vercel, port 6543):
#   DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#   Direct (migrations/long-lived hosts, port 5432):
#   DATABASE_URL=postgresql+psycopg://postgres:<password>@db.<ref>.supabase.co:5432/postgres
# NOTE: keep the "postgresql+psycopg://" prefix (driver name matters).
# Tables auto-create on first run; no manual migration needed for a fresh DB.
DATABASE_URL=sqlite:///./newsletter_machine.db
API_TOKEN=change-me-dev-token

# --- Config paths (defaults shown) ---
# NICHES_YAML=config/niches.yaml
# SOURCES_YAML=config/sources.yaml
# NEWSLETTER_YAML=config/newsletter.yaml
# OUTPUT_DIR=output/newsletters

# --- YouTube (Phase 2: YouTube Data API v3 key) ---
YOUTUBE_API_KEY=

# --- Reddit (Phase 2: script-type OAuth app) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=newsletter-machine/0.1

# --- X / Twitter (Phase 3: API v2 bearer token; expect 402/403/429 on free tiers) ---
X_BEARER_TOKEN=

# --- LinkedIn (Phase 3: official API token where permitted) ---
LINKEDIN_ACCESS_TOKEN=

# --- Instagram (Phase 3: Graph API token + business id for own account) ---
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ID=

# --- Provider fallback (Phase 3: pluggable third-party, e.g. Apify-style) ---
PROVIDER_API_KEY=
PROVIDER_BASE_URL=

# --- LLM (Phase 5) ---
LLM_PROVIDER=stub
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Delivery (Phase 6) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
RESEND_API_KEY=
DELIVERY_WEBHOOK_URL=
